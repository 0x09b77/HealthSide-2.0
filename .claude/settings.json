{
  "permissions": {
    "allow": [
      "Bash(scripts/*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcrun simctl:*)",
      "Bash(swiftformat:*)",
      "Bash(swiftlint:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push:*)"
    ]
  },
  "enableAllProjectMcpServers": true
}
